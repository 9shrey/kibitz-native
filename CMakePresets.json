{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja, warnings as errors)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "KIBITZ_WERROR": "ON" }
    },
    {
      "name": "sanitize",
      "displayName": "Debug with AddressSanitizer + UndefinedBehaviorSanitizer (Clang/GCC)",
      "inherits": "release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "KIBITZ_SANITIZE": "ON", "KIBITZ_BUILD_BENCH": "OFF" }
    },
    {
      "name": "msvc",
      "displayName": "Visual Studio 2022, x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "KIBITZ_WERROR": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
